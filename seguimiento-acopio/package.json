{
  "name": "seguimiento-acopio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:start": "npm exec --yes supabase -- start",
    "db:stop": "npm exec --yes supabase -- stop",
    "db:reset": "npm exec --yes supabase -- db reset --local",
    "db:push": "npm exec --yes supabase -- db push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
